VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# FlowAccount OpenAPI (flowaccount-issue-receipt Edge Function).
# NOT VITE_-prefixed on purpose: VITE_ vars get baked into the public JS
# bundle, and these credentials can create tax documents in the firm's
# name. Set them as function secrets in production:
#   supabase secrets set FLOWACCOUNT_CLIENT_ID=... FLOWACCOUNT_CLIENT_SECRET=...
# Default base URL is the SANDBOX — switch to
# https://openapi.flowaccount.com/v1 only when going live.
FLOWACCOUNT_BASE_URL=https://openapi.flowaccount.com/test
FLOWACCOUNT_TOKEN_URL=https://openapi.flowaccount.com/test/token
# The firm's own bank account in FlowAccount (MyCompany > ช่องทางการเงิน).
# Get the numeric id from GET /bank-accounts. Without it receipts are
# still issued but not marked as collected.
FLOWACCOUNT_BANK_ACCOUNT_ID=
FLOWACCOUNT_CLIENT_ID=your-client-id
FLOWACCOUNT_CLIENT_SECRET=your-client-secret
# true = no outbound calls, shape-identical fake responses — lets the
# whole flow be tested before real API credentials are approved.
FLOWACCOUNT_MOCK=true
